<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>true</GenerateProgramFile>
    <!-- FsCheck's own surface trips FS0064/FS3370 in places; the library itself is built
         warnings-as-errors, which is what exit criterion 5 is about. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Generators.fs" />
    <Compile Include="LayoutTests.fs" />
    <Compile Include="DTypeTests.fs" />
    <Compile Include="PromotionTests.fs" />
    <Compile Include="ShapeTests.fs" />
    <Compile Include="StorageTests.fs" />
    <Compile Include="ViewTests.fs" />
    <Compile Include="CreationTests.fs" />
    <Compile Include="StringTests.fs" />
    <Compile Include="EqualityTests.fs" />
    <Compile Include="BoolTests.fs" />
    <Compile Include="PrintingTests.fs" />
    <Compile Include="ConfigTests.fs" />
    <Compile Include="AllocationTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/YANum.Core/YANum.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsCheck.Xunit" Version="3.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
